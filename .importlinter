# =============================================================================
# import-linter — contratos de import espelhando docs/LAYOUT.md §3
# =============================================================================
# Enforcement estrutural das regras de dependência (PIPELINE §3.4; skill
# import-linter-rules). Cobre TODA regra de LAYOUT §3 expressável como
# contrato de import no grafo atual (concept 1.1 §4). Roda em `make check`
# (alvo import-check), no pre-commit e no CI (via make check).
#
# Regras de LAYOUT NÃO expressáveis como contrato de import (ficam com
# scripts/check_layout.py + revisão manual):
#   - "wiring apenas no composition_root" (LAYOUT §6) — regra de
#     instanciação, não de import;
#   - "adapters não importam outros adapters exceto via port" — a exceção
#     "via port" não é modelável em contrato estático.
#
# Contratos FUTUROS (ativar quando a estrutura existir):
#   - layers por feature (containers = restaurant_hub.features.*) — quando
#     a 1ª feature existir;
#   - exceção declarada LAYOUT §6: a cadeia shared/infrastructure/http/app
#     → composition_root → features.adapters exigirá `ignore_imports` no
#     contrato shared-nao-importa-features (documentada lá) — hoje o
#     composition_root não importa features, então não há supressão.

[importlinter]
root_packages =
    restaurant_hub
include_external_packages = True

[importlinter:contract:shared-layers]
name = shared segue camadas hexagonais (infrastructure -> application -> domain)
type = layers
layers =
    infrastructure
    application
    domain
containers =
    restaurant_hub.shared

# As listas de frameworks abaixo enumeram TODAS as libs de runtime/dev do
# pyproject que representam I/O ou boundary (LAYOUT §3 Domain: "apenas
# stdlib"). Dependência nova no pyproject => adicionar aqui no mesmo commit.
[importlinter:contract:domain-purity]
name = shared.domain nao importa camadas externas nem frameworks (LAYOUT §3 Domain)
type = forbidden
source_modules =
    restaurant_hub.shared.domain
forbidden_modules =
    restaurant_hub.shared.application
    restaurant_hub.shared.infrastructure
    restaurant_hub.features
    fastapi
    starlette
    uvicorn
    sqlalchemy
    alembic
    psycopg
    pydantic
    pydantic_settings
    httpx
    argon2
    jwt

[importlinter:contract:application-purity]
name = shared.application nao importa infrastructure nem frameworks (LAYOUT §3 Application)
type = forbidden
source_modules =
    restaurant_hub.shared.application
forbidden_modules =
    restaurant_hub.shared.infrastructure
    restaurant_hub.features
    fastapi
    starlette
    uvicorn
    sqlalchemy
    alembic
    psycopg
    pydantic
    pydantic_settings
    httpx
    argon2
    jwt

[importlinter:contract:shared-independence]
name = shared nao importa de features (LAYOUT §7 regra de ouro)
type = forbidden
source_modules =
    restaurant_hub.shared
forbidden_modules =
    restaurant_hub.features
# Exceção declarada em LAYOUT §6, prevista no cabeçalho deste arquivo desde a
# Stage 1.1 e efetivada na 2.3, quando o composition_root passou a montar os
# repositórios Postgres de identity.
#
# A cadeia real é INDIRETA: shared/infrastructure/http/app.py importa o
# composition_root, que importa features.identity.adapters. Nenhum módulo de
# `shared` importa uma feature diretamente — a regra de ouro segue valendo no
# sentido em que foi escrita.
#
# A supressão é a mais estreita possível: só este par, só nesta direção. Ela NÃO
# libera `shared -> features` em geral; um import direto de feature dentro de
# shared continua reprovando. O que ela deixa de cobrir — que nada além do
# composition_root instancie adapter — é coberto por teste mecânico em
# tests/unit/features/identity/adapters/test_composition_root_identity.py.
ignore_imports =
    restaurant_hub.shared.infrastructure.http.app -> restaurant_hub.composition_root

# Ativado na Stage 2.2 (1ª camada application do repo). Espelha para
# features.identity.application o contrato que application-purity aplica a
# shared.application (LAYOUT §3 Application: nunca importa adapters nem
# infrastructure). NÃO proíbe restaurant_hub.shared.domain nem
# restaurant_hub.shared.application (dependências legítimas: os erros herdam de
# DomainError/NotFoundError, e os use cases consomem os ports Clock/IdGenerator),
# nem restaurant_hub.features (auto-proibiria o import do próprio domínio de
# identity, que é a dependência central desta camada).
[importlinter:contract:identity-application-purity]
name = features.identity.application nao importa adapters nem frameworks (LAYOUT §3 Application)
type = forbidden
source_modules =
    restaurant_hub.features.identity.application
forbidden_modules =
    restaurant_hub.features.identity.adapters
    restaurant_hub.shared.infrastructure
    fastapi
    starlette
    uvicorn
    sqlalchemy
    alembic
    psycopg
    pydantic
    pydantic_settings
    httpx
    argon2
    jwt

# Ativado na Stage 2.1 (1ª feature — identity). Espelha para features.identity.domain
# o mesmo contrato de pureza que domain-purity aplica a shared.domain (LAYOUT §3).
# NÃO proíbe restaurant_hub.features (auto-proibiria imports internos de identity)
# nem restaurant_hub.shared.domain (dependência legítima: IdentityError herda de
# DomainError). Independence entre BCs foi ativado na Stage 3.1 (2º BC — staff);
# layers-por-feature segue futuro.
[importlinter:contract:identity-domain-purity]
name = features.identity.domain nao importa camadas externas nem frameworks (LAYOUT §3 Domain)
type = forbidden
source_modules =
    restaurant_hub.features.identity.domain
forbidden_modules =
    restaurant_hub.features.identity.application
    restaurant_hub.features.identity.adapters
    restaurant_hub.shared.application
    restaurant_hub.shared.infrastructure
    fastapi
    starlette
    uvicorn
    sqlalchemy
    alembic
    psycopg
    pydantic
    pydantic_settings
    httpx
    argon2
    jwt

# Ativado na Stage 3.2 (1ª camada application do BC staff). Espelha para
# features.staff.application o contrato que identity-application-purity aplica a
# features.identity.application (LAYOUT §3 Application: nunca importa adapters
# nem infrastructure). NÃO proíbe restaurant_hub.shared.domain nem
# restaurant_hub.shared.application (dependências legítimas: os erros herdam de
# StaffError/NotFoundError, e os use cases consomem o port IdGenerator), nem
# restaurant_hub.features (auto-proibiria o import do próprio domínio de staff,
# que é a dependência central desta camada — o import de features.identity já é
# barrado pelo contrato bc-independence).
[importlinter:contract:staff-application-purity]
name = features.staff.application nao importa adapters nem frameworks (LAYOUT §3 Application)
type = forbidden
source_modules =
    restaurant_hub.features.staff.application
forbidden_modules =
    restaurant_hub.features.staff.adapters
    restaurant_hub.shared.infrastructure
    fastapi
    starlette
    uvicorn
    sqlalchemy
    alembic
    psycopg
    pydantic
    pydantic_settings
    httpx
    argon2
    jwt

# Ativado na Stage 3.1 (1º código do BC staff). Espelha para features.staff.domain
# o contrato de pureza de identity-domain-purity (LAYOUT §3 Domain). NÃO proíbe
# restaurant_hub.features (auto-proibiria imports internos de staff) nem
# restaurant_hub.shared.domain (dependência legítima: StaffError herda de
# DomainError).
[importlinter:contract:staff-domain-purity]
name = features.staff.domain nao importa camadas externas nem frameworks (LAYOUT §3 Domain)
type = forbidden
source_modules =
    restaurant_hub.features.staff.domain
forbidden_modules =
    restaurant_hub.features.staff.application
    restaurant_hub.features.staff.adapters
    restaurant_hub.shared.application
    restaurant_hub.shared.infrastructure
    fastapi
    starlette
    uvicorn
    sqlalchemy
    alembic
    psycopg
    pydantic
    pydantic_settings
    httpx
    argon2
    jwt

# Ativado na Stage 4.1 (1º código do BC scheduling). Espelha para
# features.scheduling.domain o contrato de pureza de staff-domain-purity
# (LAYOUT §3 Domain). NÃO proíbe restaurant_hub.features (auto-proibiria imports
# internos de scheduling) nem restaurant_hub.shared.domain (dependência
# legítima: SchedulingError herda de DomainError).

[importlinter:contract:scheduling-domain-purity]
name = features.scheduling.domain nao importa camadas externas nem frameworks (LAYOUT §3 Domain)
type = forbidden
source_modules =
    restaurant_hub.features.scheduling.domain
forbidden_modules =
    restaurant_hub.features.scheduling.application
    restaurant_hub.features.scheduling.adapters
    restaurant_hub.shared.application
    restaurant_hub.shared.infrastructure
    fastapi
    starlette
    uvicorn
    sqlalchemy
    alembic
    psycopg
    pydantic
    pydantic_settings
    httpx
    argon2
    jwt

# Ativado na Stage 4.3 (1ª camada application do BC scheduling), como a 4.1
# anunciara. Espelha staff-application-purity (LAYOUT §3 Application: nunca
# importa adapters nem infrastructure nem frameworks). NÃO proíbe
# restaurant_hub.shared.domain nem restaurant_hub.shared.application (os erros
# herdam de NotFoundError; os use cases consomem Clock e IdGenerator).
[importlinter:contract:scheduling-application-purity]
name = features.scheduling.application nao importa adapters nem frameworks (LAYOUT §3 Application)
type = forbidden
source_modules =
    restaurant_hub.features.scheduling.application
forbidden_modules =
    restaurant_hub.features.scheduling.adapters
    restaurant_hub.shared.infrastructure
    fastapi
    starlette
    uvicorn
    sqlalchemy
    alembic
    psycopg
    pydantic
    pydantic_settings
    httpx
    argon2
    jwt

# Ativado na Stage 3.1, quando o 2º BC (staff) passou a existir — contrato de
# independência entre bounded contexts planejado no cabeçalho deste arquivo
# desde a 1.1. BCs se comunicam por ports (identificadores atravessam a
# fronteira como strings opacas), nunca por import direto entre features.
#
# Stage 3.5 — a **única** aresta entre os dois BCs, nomeada (ADR 3.5.0001 §3).
# A forma é a regra: o curinga fica só do lado do CONSUMIDOR e casa nomes de
# módulo, não subpacotes — qualquer módulo novo sob `staff/adapters/out/identity/`
# herda a permissão; qualquer módulo de staff fora dali, e qualquer import de
# identity que não seja a fachada, continua reprovando. `unmatched_ignore_imports_alerting
# = error` faz o par apontar para um import que exista: se o gateway deixar de
# importar a fachada, a supressão vira erro em vez de lixo silencioso.
# `tests/unit/features/staff/test_bc_independence.py` assere a lista EXATA, para
# que um segundo par entre por decisão, nunca por deriva.
#
# Stage 4.1: entra o 3º BC (scheduling). `type = independence` é par a par entre
# TODOS os módulos listados, logo os três pares passam a ser cobrados de uma vez
# — e um BC **fora** da lista não violaria nada, que é por que
# tests/unit/features/staff/test_bc_independence.py cobra esta lista contra a
# pasta features/ desde a 4.1.
[importlinter:contract:bc-independence]
name = bounded contexts identity, scheduling e staff sao independentes (LAYOUT §1)
type = independence
modules =
    restaurant_hub.features.identity
    restaurant_hub.features.scheduling
    restaurant_hub.features.staff
ignore_imports =
    restaurant_hub.features.staff.adapters.out.identity.* -> restaurant_hub.features.identity.application.facade
unmatched_ignore_imports_alerting = error
