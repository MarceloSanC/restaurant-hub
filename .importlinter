# =============================================================================
# import-linter — contratos de import espelhando docs/LAYOUT.md §3
# =============================================================================
# Enforcement estrutural das regras de dependência (PIPELINE §3.4; skill
# import-linter-rules). Cobre TODA regra de LAYOUT §3 expressável como
# contrato de import no grafo atual (concept 1.1 §4). Roda em `make check`
# (alvo import-check), no pre-commit e no CI (via make check).
#
# Regras de LAYOUT NÃO expressáveis como contrato de import (ficam com
# scripts/check_layout.py + revisão manual):
#   - "wiring apenas no composition_root" (LAYOUT §6) — regra de
#     instanciação, não de import;
#   - "adapters não importam outros adapters exceto via port" — a exceção
#     "via port" não é modelável em contrato estático.
#
# Contratos FUTUROS (ativar quando a estrutura existir):
#   - independence entre bounded contexts (`type = independence` com
#     restaurant_hub.features.*) — quando o 2º BC existir;
#   - layers por feature (containers = restaurant_hub.features.*) — quando
#     a 1ª feature existir;
#   - exceção declarada LAYOUT §6: a cadeia shared/infrastructure/http/app
#     → composition_root → features.adapters exigirá `ignore_imports` no
#     contrato shared-nao-importa-features (documentada lá) — hoje o
#     composition_root não importa features, então não há supressão.

[importlinter]
root_packages =
    restaurant_hub
include_external_packages = True

[importlinter:contract:shared-layers]
name = shared segue camadas hexagonais (infrastructure -> application -> domain)
type = layers
layers =
    infrastructure
    application
    domain
containers =
    restaurant_hub.shared

# As listas de frameworks abaixo enumeram TODAS as libs de runtime/dev do
# pyproject que representam I/O ou boundary (LAYOUT §3 Domain: "apenas
# stdlib"). Dependência nova no pyproject => adicionar aqui no mesmo commit.
[importlinter:contract:domain-purity]
name = shared.domain nao importa camadas externas nem frameworks (LAYOUT §3 Domain)
type = forbidden
source_modules =
    restaurant_hub.shared.domain
forbidden_modules =
    restaurant_hub.shared.application
    restaurant_hub.shared.infrastructure
    restaurant_hub.features
    fastapi
    starlette
    uvicorn
    sqlalchemy
    alembic
    psycopg
    pydantic
    pydantic_settings
    httpx
    argon2
    jwt

[importlinter:contract:application-purity]
name = shared.application nao importa infrastructure nem frameworks (LAYOUT §3 Application)
type = forbidden
source_modules =
    restaurant_hub.shared.application
forbidden_modules =
    restaurant_hub.shared.infrastructure
    restaurant_hub.features
    fastapi
    starlette
    uvicorn
    sqlalchemy
    alembic
    psycopg
    pydantic
    pydantic_settings
    httpx
    argon2
    jwt

[importlinter:contract:shared-independence]
name = shared nao importa de features (LAYOUT §7 regra de ouro)
type = forbidden
source_modules =
    restaurant_hub.shared
forbidden_modules =
    restaurant_hub.features
# Exceção declarada em LAYOUT §6, prevista no cabeçalho deste arquivo desde a
# Stage 1.1 e efetivada na 2.3, quando o composition_root passou a montar os
# repositórios Postgres de identity.
#
# A cadeia real é INDIRETA: shared/infrastructure/http/app.py importa o
# composition_root, que importa features.identity.adapters. Nenhum módulo de
# `shared` importa uma feature diretamente — a regra de ouro segue valendo no
# sentido em que foi escrita.
#
# A supressão é a mais estreita possível: só este par, só nesta direção. Ela NÃO
# libera `shared -> features` em geral; um import direto de feature dentro de
# shared continua reprovando. O que ela deixa de cobrir — que nada além do
# composition_root instancie adapter — é coberto por teste mecânico em
# tests/unit/features/identity/adapters/test_composition_root_identity.py.
ignore_imports =
    restaurant_hub.shared.infrastructure.http.app -> restaurant_hub.composition_root

# Ativado na Stage 2.2 (1ª camada application do repo). Espelha para
# features.identity.application o contrato que application-purity aplica a
# shared.application (LAYOUT §3 Application: nunca importa adapters nem
# infrastructure). NÃO proíbe restaurant_hub.shared.domain nem
# restaurant_hub.shared.application (dependências legítimas: os erros herdam de
# DomainError/NotFoundError, e os use cases consomem os ports Clock/IdGenerator),
# nem restaurant_hub.features (auto-proibiria o import do próprio domínio de
# identity, que é a dependência central desta camada).
[importlinter:contract:identity-application-purity]
name = features.identity.application nao importa adapters nem frameworks (LAYOUT §3 Application)
type = forbidden
source_modules =
    restaurant_hub.features.identity.application
forbidden_modules =
    restaurant_hub.features.identity.adapters
    restaurant_hub.shared.infrastructure
    fastapi
    starlette
    uvicorn
    sqlalchemy
    alembic
    psycopg
    pydantic
    pydantic_settings
    httpx
    argon2
    jwt

# Ativado na Stage 2.1 (1ª feature — identity). Espelha para features.identity.domain
# o mesmo contrato de pureza que domain-purity aplica a shared.domain (LAYOUT §3).
# NÃO proíbe restaurant_hub.features (auto-proibiria imports internos de identity)
# nem restaurant_hub.shared.domain (dependência legítima: IdentityError herda de
# DomainError). Independence entre BCs e layers-por-feature seguem futuros (2º BC /
# quando a camada application existir).
[importlinter:contract:identity-domain-purity]
name = features.identity.domain nao importa camadas externas nem frameworks (LAYOUT §3 Domain)
type = forbidden
source_modules =
    restaurant_hub.features.identity.domain
forbidden_modules =
    restaurant_hub.features.identity.application
    restaurant_hub.features.identity.adapters
    restaurant_hub.shared.application
    restaurant_hub.shared.infrastructure
    fastapi
    starlette
    uvicorn
    sqlalchemy
    alembic
    psycopg
    pydantic
    pydantic_settings
    httpx
    argon2
    jwt
