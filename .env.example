# =============================================================================
# .env.example — Restaurant Hub
# =============================================================================
# Copie para .env e ajuste os valores conforme o ambiente.
# NUNCA commite o .env real (já está no .gitignore).
#
# Os campos espelham `src/restaurant_hub/shared/infrastructure/config/settings.py`.
# Valores ausentes caem nos defaults declarados no Settings.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=restaurant_hub
# Em produção: DEBUG=false. Em dev local: DEBUG=true (logs mais verbosos).
DEBUG=true

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Formato: postgresql+psycopg://usuario:senha@host:porta/banco
#
# O esquema nomeia o driver (Stage 2.3). `postgresql://` sozinho faz o SQLAlchemy
# procurar o psycopg2, que o projeto nao declara — use sempre `+psycopg`.
#
# Host conforme o caminho de setup (ver README.md §Setup local):
#   - Caminho A devcontainer ou B compose direto: use `postgres` (nome do service
#     do compose) — dentro do container, `localhost` aponta para o proprio container.
#   - Caminho C host nativo: use `localhost`.
#   - Producao: use o hostname real do banco.
#
# PORTA: em worktree paralela o compose publica o Postgres na POSTGRES_PORT desta
# worktree (ver secao Docker abaixo), nao em 5432. Ajuste a porta da URL junto.
#
# Os testes de integracao exigem este banco no ar — nao ha caminho de skip
# (ADR 2.3.0001). Suba com `make docker-up`.
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/restaurant_hub

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# Docker / worktrees paralelas
# ---------------------------------------------------------------------------
# Portas no HOST para o `docker-compose.yml` (dentro do container as portas
# continuam fixas em 8000/5432/6379). Defaults preservam o comportamento
# de uma única worktree. Em worktrees paralelas, o script
# `scripts/worktree-new.py` gera um `.env` com valores incrementados
# (8001/5433/6380, etc.) para evitar conflito de bind no host.
APP_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Valores válidos: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
