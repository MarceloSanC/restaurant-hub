# =============================================================================
# .env.example — Restaurant Hub
# =============================================================================
# Copie para .env e ajuste os valores conforme o ambiente.
# NUNCA commite o .env real (já está no .gitignore).
#
# Os campos espelham `src/restaurant_hub/shared/infrastructure/config/settings.py`.
# Valores ausentes caem nos defaults declarados no Settings.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=restaurant_hub
# Em produção: DEBUG=false. Em dev local: DEBUG=true (logs mais verbosos).
DEBUG=true

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Formato: postgresql+psycopg://usuario:senha@host:porta/banco
#
# O esquema nomeia o driver (Stage 2.3). `postgresql://` sozinho faz o SQLAlchemy
# procurar o psycopg2, que o projeto nao declara — use sempre `+psycopg`.
#
# Host conforme o caminho de setup (ver README.md §Setup local):
#   - Caminho A devcontainer ou B compose direto: use `postgres` (nome do service
#     do compose) — dentro do container, `localhost` aponta para o proprio container.
#   - Caminho C host nativo: use `localhost`.
#   - Producao: use o hostname real do banco.
#
# PORTA: em worktree paralela o compose publica o Postgres na POSTGRES_PORT desta
# worktree (ver secao Docker abaixo), nao em 5432. Ajuste a porta da URL junto.
#
# Os testes de integracao exigem este banco no ar — nao ha caminho de skip
# (ADR 2.3.0001). Suba com `make docker-up`.
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/restaurant_hub

# ---------------------------------------------------------------------------
# Seguranca / tokens (Stage 2.4)
# ---------------------------------------------------------------------------
# Segredo de assinatura do access token (HS256).
#
# EM PRODUCAO, TROQUE. O valor abaixo e o default do Settings e e inseguro de
# proposito. Gere um segredo real com, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Nao ha checagem de boot que impeca subir em producao com o default — a suite
# de testes roda com DEBUG=false e a checagem quebraria os testes. Esta
# registrado como pendencia para a Stage 6.2-deploy-pipeline.
JWT_SECRET_KEY=dev-insecure-change-me-0000000000000000

# Algoritmo de assinatura. HS256 (simetrico) porque um unico servico assina e
# verifica.
JWT_ALGORITHM=HS256

# TTL do access token, em minutos. E esta a janela de revogacao do sistema:
# revogar a sessao corta o refresh na hora, e o access sobrevive no maximo
# este tempo.
ACCESS_TOKEN_TTL_MINUTES=15

# TTL do refresh token, em dias. Renovado a cada rotacao.
REFRESH_TOKEN_TTL_DAYS=14

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# Docker / worktrees paralelas
# ---------------------------------------------------------------------------
# Portas no HOST para o `docker-compose.yml` (dentro do container as portas
# continuam fixas em 8000/5432/6379). Defaults preservam o comportamento
# de uma única worktree. Em worktrees paralelas, o script
# `scripts/worktree-new.py` gera um `.env` com valores incrementados
# (8001/5433/6380, etc.) para evitar conflito de bind no host.
APP_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Valores válidos: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Convite e definicao de senha (Stage 2.5)
# ---------------------------------------------------------------------------
# Base do link enviado por e-mail. E a URL da aplicacao web, nao da API.
APP_BASE_URL=http://localhost:8000

# Prazo do link de convite, em horas. Tolera o atraso humano de quem so abre o
# e-mail no dia seguinte.
INVITATION_TOKEN_TTL_HOURS=72

# Prazo do link de redefinicao de senha, em minutos. Curto de proposito: reduz a
# janela em que um e-mail interceptado ainda vale.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Prazo do link de definicao de senha entregue EM MAOS pelo gestor (Stage 3.5,
# canal `link` da criacao de login do funcionario), em horas. Mais longo que o do
# convite por e-mail: o link impresso hoje pode ser aberto so na semana seguinte.
HANDOVER_LINK_TTL_HOURS=168
