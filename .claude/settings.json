{
  "permissions": {
    "allow": [
      "Bash(git mv *)",
      "Bash(python scripts/session_cost.py *)",
      "Bash(python */scripts/session_cost.py *)"
    ]
  },
  "env": {
    "UV_SYSTEM_CERTS": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/triage_gate.py"]
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/git_guard.py"]
          },
          {
            "type": "command",
            "if": "PowerShell(git *)",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/git_guard.py"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/triage_gate.py"]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/triage_gate.py"]
          }
        ]
      }
    ]
  }
}
